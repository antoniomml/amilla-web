{
  "name": "amilla-es",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Static personal portfolio for Antonio Milla.",
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/css/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "validate:html": "html-validate \"public/**/*.html\"",
    "verify": "node scripts/verify-site.mjs",
    "test": "npm run build && npm run format:check && npm run lint && npm run validate:html && npm run verify",
    "build": "node scripts/build.mjs",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "html-validate": "^11.21.0",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
}
