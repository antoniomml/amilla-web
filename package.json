{
  "name": "amilla-es",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Static personal portfolio for Antonio Milla.",
  "scripts": {
    "dev": "python3 -m http.server 8000 --directory public",
    "assets": "node scripts/generate-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"public/css/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "validate:html": "html-validate \"public/**/*.html\"",
    "verify": "node scripts/verify-site.mjs",
    "test": "npm run format:check && npm run lint && npm run validate:html && npm run verify"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "html-validate": "^11.8.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
